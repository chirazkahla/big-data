USE default_keyspace;

SELECT * FROM restaurant;

SELECT name FROM restaurant;

SELECT name, borough
FROM restaurant
WHERE id = 41569764;

SELECT inspectiondate, grade
FROM inspection
WHERE idrestaurant = 41569764;

SELECT name
FROM restaurant
WHERE cuisinetype = 'French' ALLOW FILTERING;

SELECT name
FROM restaurant
WHERE borough = 'BROOKLYN' ALLOW FILTERING;

SELECT grade, score
FROM inspection
WHERE idrestaurant = 41569764 AND score >= 10 ALLOW FILTERING;

SELECT grade
FROM inspection
WHERE score > 30 AND grade != '' ALLOW FILTERING;

SELECT COUNT(*)
FROM inspection
WHERE score > 30 AND grade != '' ALLOW FILTERING;

CREATE INDEX idx_borough ON restaurant (borough);

CREATE INDEX idx_cuisine ON restaurant (cuisinetype);

SELECT name FROM restaurant WHERE borough = 'QUEENS' ALLOW FILTERING;

SELECT name FROM restaurant WHERE cuisinetype = 'Italian' ALLOW FILTERING;

CREATE INDEX IF NOT EXISTS fk_restaurant_cuisine 
ON restaurant (cuisinetype);

SELECT * FROM restaurant WHERE cuisinetype = 'French';

SELECT name FROM restaurants_by_borough WHERE borough='QUEENS';

CREATE INDEX IF NOT EXISTS fk_inspection_grade
ON inspection (grade);

SELECT *
FROM inspection
WHERE grade = 'A' ALLOW FILTERING;

CREATE TABLE IF NOT EXISTS restaurants_by_borough (
    borough text,
    id int,
    name text,
    buildingnum text,
    street text,
    zipcode int,
    phone text,
    cuisinetype text,
    PRIMARY KEY (borough, id)
);

CREATE TABLE IF NOT EXISTS restaurants_by_cuisine (
    cuisinetype text,
    id int,
    name text,
    borough text,
    buildingnum text,
    street text,
    zipcode int,
    phone text,
    PRIMARY KEY (cuisinetype, id)
);

CREATE TABLE IF NOT EXISTS inspections_by_grade (
    grade text,
    idrestaurant int,
    inspectiondate date,
    violationcode text,
    violationdescription text,
    score int,
    criticalflag text,
    PRIMARY KEY (grade, idrestaurant, inspectiondate)
);

CREATE TABLE IF NOT EXISTS restaurants_by_borough (
    borough text,
    id int,
    name text,
    buildingnum text,
    street text,
    zipcode int,
    phone text,
    cuisinetype text,
    PRIMARY KEY (borough, id)
);

SELECT name 
FROM restaurants_by_borough 
WHERE borough='QUEENS';
